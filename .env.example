# 复制为 .env 后填写；.env 不入库
# 豆包 / 火山方舟
ARK_API_KEY=
# 主力档模型 ID，或用 ep- 开头的推理接入点 ID
ARK_MODEL=
# 便宜档，用于跑批与回归
ARK_MODEL_MINI=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 价目（元/百万 token），按方舟当前价目填写
ARK_PRICE_IN=0.8
ARK_PRICE_OUT=3.2
ARK_PRICE_CACHED=0.016

# 工具可访问的仓库根目录；留空表示当前工作目录
AGENT_PROJECT_ROOT=

# 单次运行的最大步数上限
AGENT_MAX_STEPS=12

# 网关（从 gateway/ 目录启动；默认豆包，可切到 mock 离线验证）
GATEWAY_PROVIDER=doubao
GATEWAY_PORT=8080
GATEWAY_TIMEOUT=30s
GATEWAY_MAX_CONCURRENCY=200
GATEWAY_MAX_RETRIES=3
GATEWAY_TRACE_DIR=traces
# 路由规则：simple 使用经济模型，complex 或长上下文使用主力模型
GATEWAY_ROUTE_SIMPLE_MODEL=
GATEWAY_ROUTE_COMPLEX_MODEL=
GATEWAY_ROUTE_CONTEXT_THRESHOLD=8192
# 语义缓存相似度阈值（越高越保守）
GATEWAY_SEMANTIC_CACHE_THRESHOLD=0.95
# 预算限制；未显式传 max_tokens/max_completion_tokens 时默认限制输出上限
GATEWAY_DAILY_BUDGET_YUAN=100
GATEWAY_REQUEST_MAX_COST_YUAN=0.50
GATEWAY_BUDGET_MAX_OUTPUT_TOKENS=4096
GATEWAY_BUDGET_STATE_FILE=traces/budget.json

# 网关价格预留（元 / 百万 token；本周 trace 成本暂记为 0）
ARK_PRICE_IN=0.8
ARK_PRICE_OUT=3.2
ARK_PRICE_CACHED=0.016

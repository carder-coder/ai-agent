# 复制为 .env 后填写；.env 不入库
# 豆包 / 火山方舟
ARK_API_KEY=
# 主力档模型 ID，或用 ep- 开头的推理接入点 ID
ARK_MODEL=
# 便宜档，用于跑批与回归
ARK_MODEL_MINI=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 价目（元/百万 token），按方舟控制台当下价格填
ARK_PRICE_IN=6
ARK_PRICE_OUT=30
ARK_PRICE_CACHED=1.2

# 工具可访问的仓库根目录；留空表示当前工作目录
AGENT_PROJECT_ROOT=

# 单次运行的最大步数上限
AGENT_MAX_STEPS=12
